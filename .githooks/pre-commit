#!/bin/sh
# Blocks a commit that changes a cached file (images/ videos/ shared/ data/ 3d-model/) without a NEW ?v= stamp,
# or that edits a PDF in presentations/ in place. Rules + fix: .claude/skills/cache-bust/SKILL.md
# One-time per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
node scripts/cache-bust-check.js --staged
