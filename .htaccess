# === CONNEXUS 2026 — cache policy ===
# Problem this solves: after a deploy, browsers kept serving the OLD .html
# from cache because the files had no cache headers (browser "heuristic"
# caching). These rules force the browser to re-check the server for HTML on
# every visit, so a fresh deploy shows up immediately.
#
# !! NOT ACTIVE ON THE CURRENT SERVER !!
# The live site runs on IIS behind Cloudflare, which ignores .htaccess
# entirely. The cache policy that is actually in effect lives in
# web.config at the site root -- edit that one. This file is kept only
# so the policy survives a future move to Apache.
#
# The <IfModule> guards mean it also can't break Apache if the
# mod_headers / mod_expires modules aren't loaded.

# --- HTML documents: never trust the cache, always revalidate ---
<IfModule mod_headers.c>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# --- Belt-and-suspenders if mod_expires is available ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
