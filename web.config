<?xml version="1.0" encoding="UTF-8"?>
<!--
  CONNEXUS 2026 - browser cache policy (IIS)
  Author: Todor Belchev

  Problem this solves: the live server was sending
      Cache-Control: max-age=2592000     (30 days)
  on every .html document. A returning visitor kept getting the OLD page
  straight from their browser's disk cache for up to a month, without ever
  asking the server - so deploys were invisible to anyone who had visited
  before.

  Note: .htaccess in this repo targets Apache and is IGNORED here (this site
  runs on IIS). THIS file is the one that is actually in effect.

  Policy
  ~~~~~~
  HTML  -> Cache-Control: max-age=120, must-revalidate
           Two minutes of "trust the cache", then the browser MUST re-check
           with the server before reusing its copy. Measured on the live
           site: a full page is 53 KB gzipped / ~190 ms, a revalidation that
           finds no change is 0 bytes / ~180 ms.

           Why 120s and not no-cache: the 180 ms is almost entirely origin
           round-trip (Cloudflare serves HTML as DYNAMIC, so a revalidation
           travels all the way to the origin). The 2-minute window makes
           in-session clicking between pages cost nothing, while anyone who
           comes back later than that still gets the current deploy. The
           only thing given up is that a reload within 2 minutes OF A DEPLOY
           may still show the previous page.

  Assets -> Cache-Control: max-age=2678400 (31 days) - UNCHANGED from the
           current server behaviour. Safe because every reference to them
           carries a ?v=YYYYMMDD cache-busting string, so a changed file is
           a changed URL.

  Rollback: delete or rename this file. Nothing else depends on it.
-->
<configuration>

  <!-- ================================================================
       DEFAULT: 2 minutes of freshness, then revalidate.
       This covers all .html at the site root (index, speakers, speaker,
       sponsors, expo, participants) plus robots.txt / sitemap.xml, and it
       is inherited by /en/, which is HTML-only.

       Classic ASP (send-email.asp) is dynamic content and is not touched
       by <clientCache> - it already sends its own no-cache header.
       ================================================================ -->
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 301 redirect index.html (and en/index.html) to their directory root,
             so /index.html and https://www.blackseatech.org/index.html canonicalize
             to / (and /en/). -->
        <rule name="Redirect index.html to root" stopProcessing="true">
          <match url="^(en/)?index\.html$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 301 redirect the retired speaker stanislav-simeonov to the speaker who
             replaced him in the same session (Ivaylo Konev, Neterra - joint talk with
             Alexander Minchev), added 2026-09-10. His page was public and its URL was
             shared in email, so it must not 404. Keeps the visitor in the language
             they arrived in: /speakers/... -> /speakers/..., /en/... -> /en/... -->
        <rule name="Retired speaker stanislav-simeonov" stopProcessing="true">
          <match url="^(en/)?speakers/stanislav-simeonov/?$" />
          <action type="Redirect" url="/{R:1}speakers/ivaylo-konev/" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- ================================================================
         REMOVE THE SITE-WIDE "X-Robots-Tag: noindex" HEADER.

         Measured on the live site 2026-09-11 - every URL answered with
             x-robots-tag: noindex
         on the homepage, /en/, every speaker profile, and also on
         robots.txt, sitemap.xml, JS and images. That one header tells
         Google to drop the whole site from the index, and it outranks
         everything in the HTML: correct canonical, hreflang, sitemap and
         structured data are all irrelevant while it is being sent.

         It does NOT come from this repository - there is no
         meta robots="noindex" on index.html / en/index.html, and
         robots.txt says Allow: /. It is injected above this site. Evidence
         that it is origin-level and not specific to blackseatech.org:
         www.blackseatech.org is a CNAME to
         blackseatechorg.shopmetrics.com.cdn.cloudflare.net, and
         https://velocity.online/ - a sibling property on the same
         infrastructure - returns the identical X-Robots-Tag: noindex.
         So: one inherited IIS custom response header, set once for the
         whole box, which this site inherits.

         <remove> cancels it for THIS site, which works if the source is an
         inherited IIS customHeaders entry. That is the likely case (the
         header comes back capitalised exactly as IIS writes it).

         !! MUST BE VERIFIED AFTER DEPLOY !!
             curl -sI https://www.blackseatech.org/ | grep -i robots
         Expected: no output at all. If the header is still there, it is
         added by a Cloudflare Transform Rule (Rules -> Transform Rules ->
         Modify Response Header) or by a native IIS module - neither can be
         switched off from this file, and only the server owner can remove
         it.
         ================================================================ -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Robots-Tag" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge"
                   cacheControlMaxAge="00:02:00"
                   cacheControlCustom="must-revalidate" />
    </staticContent>
  </system.webServer>

  <!-- ================================================================
       ASSET DIRECTORIES: keep the existing 31-day browser cache.
       All references to these carry ?v=YYYYMMDD, so a new deploy changes
       the URL and the browser fetches it fresh regardless of this TTL.
       ================================================================ -->
  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="31.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="videos">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="31.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="shared">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="31.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="data">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="31.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="3d-model">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="31.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- ================================================================
       EXCEPTION inside /data/: promo-codes.json.
       index.html / en/index.html fetch it as a bare
           fetch('data/promo-codes.json')
       with NO ?v= cache-buster, so under the 31-day rule above an edited
       promo code would not reach a returning visitor for a month. Put back on the
       same 2-minute policy as the HTML.
       A more specific <location> wins in IIS, so this overrides /data/.
       ================================================================ -->
  <location path="data/promo-codes.json">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge"
                     cacheControlMaxAge="00:02:00"
                     cacheControlCustom="must-revalidate" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
